# ============================================================
# CLOUDFLARE TUNNEL CONFIGURATION — EXAMPLE TEMPLATE
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.
# ============================================================

# Your Cloudflare tunnel URL (from: npx cloudflared tunnel --url http://localhost:3000)
CLOUDFLARE_TUNNEL_URL=https://your-tunnel-name.trycloudflare.com

# Server port (default: 3000)
PORT=3000
