# ============================================================
# CLOUDFLARE TUNNEL CONFIGURATION — EXAMPLE TEMPLATE
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.
# ============================================================

# Your Cloudflare tunnel URL (from: npx cloudflared tunnel --url http://localhost:3000)
# Used by server.js for CORS and by index.html for Socket.IO from outside the LAN.
CLOUDFLARE_TUNNEL_URL=https://your-tunnel-name.trycloudflare.com

# Server port (default: 3000)
PORT=3000

# ============================================================
# ESP32 USB SERIAL CONFIGURATION
# ============================================================
# The COM port the ESP32 is plugged into.
# Windows: check Device Manager > Ports (COM & LPT) after plugging in the ESP32.
# (e.g. COM3, COM6)
SERIAL_PORT=COM6

# Must match monitor_speed in platformio.ini (default: 115200)
BAUD_RATE=115200
